				{
					"name": "Verify OTP (Login / Signup)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.data.accessToken);",
									"    if (jsonData.data.refreshToken) {",
									"        pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    }",
									"    console.log(\"Saved tokens to collection variables\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"+919876543210\",\n    \"otp\": \"123456\",\n    \"role\": \"CUSTOMER\"\n}"

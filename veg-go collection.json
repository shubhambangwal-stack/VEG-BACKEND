							"raw": "{{base_url}}/api/auth/logout",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Revoke the specified refresh token and log out the user."
					},
					"response": []
				},

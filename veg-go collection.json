	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Request OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"+919876543210\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/otp/request",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"auth",
								"otp",
								"request"
							]
						},
						"description": "Send a 6-digit OTP code to the provided phone number. Check the backend server logs/console output to read the generated OTP code."
					},
					"response": []
				},
				{
					"name": "Verify OTP (Login / Signup)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.data.accessToken);",
									"    if (jsonData.data.refreshToken) {",
									"        pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    }",
									"    console.log(\"Saved tokens to collection variables\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"+919876543210\",\n    \"otp\": \"123456\",\n    \"role\": \"CUSTOMER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/otp/verify",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"auth",
								"otp",
								"verify"
							]
						},
						"description": "Verify OTP. If the user doesn't exist, they are registered with the specified role. Returns access and refresh tokens."
					},
					"response": []
				},
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.data.accessToken);",
									"    if (jsonData.data.refreshToken) {",
									"        pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    }",
									"    console.log(\"Saved Admin tokens to collection variables\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@veg.go\",\n    \"password\": \"#vegGo123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/admin/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"auth",
								"admin",
								"login"
							]
						},
						"description": "Authenticate admin user via email and password. Returns JWT tokens."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.data.accessToken);",
									"    if (jsonData.data.refreshToken) {",
									"        pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/refresh",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"auth",
								"refresh"
							]
						},
						"description": "Obtain a fresh access token using a valid, unexpired refresh token."
					},
					"response": []
				},
				{
					"name": "Logout",

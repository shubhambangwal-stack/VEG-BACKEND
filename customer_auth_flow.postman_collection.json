{
	"info": {
		"_postman_id": "8b512c14-25e2-45e0-94e8-f58c704fcd2d",
		"name": "Veg Fresh Customer Flow",
		"description": "API collection for testing Veg Fresh Customer Signup, Login, and Profile endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Request OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"+919876543210\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/otp/request",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"auth",
								"otp",
								"request"
							]
						},
						"description": "Send a 6-digit OTP code to the provided phone number. Check the backend server logs/console output to read the generated OTP code."
					},
					"response": []
				},
				{
					"name": "Verify OTP (Login / Signup)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.data.accessToken);",
									"    console.log(\"Saved accessToken to collection variable: jwt_token\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"+919876543210\",\n    \"otp\": \"123456\",\n    \"role\": \"CUSTOMER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/otp/verify",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"auth",
								"otp",
								"verify"
							]
						},
						"description": "Verify OTP. If the user doesn't exist, they are registered with the specified role. Returns a JWT access token which is automatically saved to the collection variable `jwt_token`."
					},
					"response": []
				}
			]
		},
		{
			"name": "Customer",
			"item": [
				{
					"name": "Get Profile",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/customer/profile",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"customer",
								"profile"
							]
						},
						"description": "Retrieves the authenticated customer's profile. If it doesn't exist yet, it is automatically created."
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	]
}

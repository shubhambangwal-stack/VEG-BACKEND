{
	"info": {
		"_postman_id": "8b46dc3c-cd8e-49b8-a89b-9871fe4d7001",
		"name": "Admin Collection",
		"description": "API Collection containing Admin authentication, Admin Dashboard, Customer management endpoints, and core Auth flows for VegGo Fresh platform.",

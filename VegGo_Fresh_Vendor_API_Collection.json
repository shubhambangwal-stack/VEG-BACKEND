					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
						},
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/vendor/shop/kyc-documents",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vendor", "shop", "kyc-documents"]
						}
					}
				}
			]
		},
